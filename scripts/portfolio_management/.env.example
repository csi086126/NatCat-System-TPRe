# Environment Variables Configuration

# ====== 数据库配置 ======
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natcat_portfolio
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# PostGIS Extension
POSTGIS_VERSION=3.3

# ====== Geocoding API ======
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
AMAP_API_KEY=your_amap_api_key_here

# ====== API Server ======
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # 开发模式

# API Authentication (可选)
API_SECRET_KEY=your-secret-key-change-this-in-production
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ====== 数据源路径 ======
TPHK_POLICY_FILE=D:\Nat Cat Platform\Data\Insurance_data_Taiping\TPHK\2412 巨災統計-承保信息 (香港地區).xlsx
TPHK_CLAIM_FILE=D:\Nat Cat Platform\Data\Insurance_data_Taiping\TPHK\2412 巨災統計-理赔信息 (香港地區).xlsx

# ====== 输出路径 ======
OUTPUT_DATA_DIR=D:\Nat Cat Platform\UI_system\public\data
CACHE_DIR=D:\Nat Cat Platform\UI_system\scripts\portfolio_management\cache
LOG_DIR=D:\Nat Cat Platform\UI_system\scripts\portfolio_management\logs

# ====== 处理配置 ======
GEOCODING_RATE_LIMIT=10  # 每秒请求数
BATCH_SIZE=100           # 批量处理大小
MAX_WORKERS=4            # 并发工作线程数

# ====== 缓存配置 (可选) ======
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# CACHE_EXPIRE_SECONDS=3600

# ====== 日志配置 ======
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ====== CORS配置 ======
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOW_CREDENTIALS=true

# ====== 阿里云 OSS (PDF 报告存储) ======
# 凭证从阿里云 RAM 控制台创建,权限:AliyunOSSFullAccess(开发) / 自定义只写+读(生产)
# OSS 未配置时,前端下载按钮会自动降级到 jsPDF fallback(无存档)。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=natcat-reports
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_SIGNED_URL_TTL_HOURS=24

# ====== FastAPI 启动配置 =====
# api/main.py 启动时读取(同根 .env 的 FASTAPI_PORT)
FASTAPI_PORT=8765

# ====== 应用环境 =====
# development / staging / production
NATCAT_ENV=development

# ====== JWT / 密码 =====
# JWT 签名密钥 — 用 `python -c "import secrets;print(secrets.token_urlsafe(64))"` 生成
JWT_SECRET=your-jwt-secret-change-in-production-use-secrets-token-urlsafe
JWT_TTL_HOURS=24
BCRYPT_ROUNDS=10
AUTH_COOKIE_NAME=natcat_session

# ====== 前端 URL(用于 set-password 邮件链接) =====
FRONTEND_URL=http://localhost:3004

# ====== 邮件 (SMTP) =====
# 邮件用于注册验证、密码重置。开发期可设 SMTP_MOCK=true 用控制台日志代替真发
SMTP_MOCK=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=false
SENDER_EMAIL=noreply@natcat.local
SENDER_NAME=NatCat Platform
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2

# ====== 输出路径(供 scripts/portfolio_management/data_processing 用) =====
PUBLIC_DATA_DIR=D:/Nat Cat Platform/UI_system/public/data
