<?xml version="1.0" encoding="UTF-8"?>
<StyledLayerDescriptor version="1.0.0" xmlns="http://www.opengis.net/sld" xmlns:ogc="http://www.opengis.net/ogc" xmlns:xlink="http://www.opengis.net/xlink" xmlns:sld="http://www.opengis.net/sld" xmlns:gml="http://www.opengis.net/gml">
  <sld:NamedLayer>
    <sld:Name>dem_macau</sld:Name>
    <sld:UserStyle>
      <sld:Name>dem_macau</sld:Name>
      <sld:Title>Macau DEM (Viridis-Inspired Elevation, 0-200m)</sld:Title>
      <sld:Abstract>Modern elevation color ramp for Macau DEM, sea (≤0m) is transparent. Range 0-200m with viridis-inspired gradient.</sld:Abstract>
      <sld:FeatureTypeStyle>
        <sld:Rule>
          <sld:RasterSymbolizer>
            <sld:ColorMap>
              <!-- Sea level and below: transparent (no entry) -->
              <sld:ColorMapEntry color="#000000" quantity="-100" label="below sea"/>
              <!-- Land: viridis-inspired gradient from low to high -->
              <sld:ColorMapEntry color="#FDE725" quantity="0" label="0m" opacity="0"/>
              <sld:ColorMapEntry color="#B5DE2B" quantity="5" label="5m" opacity="0.6"/>
              <sld:ColorMapEntry color="#6DCD59" quantity="15" label="15m" opacity="0.7"/>
              <sld:ColorMapEntry color="#1F9E89" quantity="30" label="30m" opacity="0.8"/>
              <sld:ColorMapEntry color="#26828E" quantity="50" label="50m" opacity="0.85"/>
              <sld:ColorMapEntry color="#3E4989" quantity="80" label="80m" opacity="0.9"/>
              <sld:ColorMapEntry color="#482878" quantity="120" label="120m" opacity="0.95"/>
              <sld:ColorMapEntry color="#440154" quantity="200" label="200m+"/>
            </sld:ColorMap>
          </sld:RasterSymbolizer>
        </sld:Rule>
      </sld:FeatureTypeStyle>
    </sld:UserStyle>
  </sld:NamedLayer>
</StyledLayerDescriptor>
