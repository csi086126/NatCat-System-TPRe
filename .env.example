# GeoServer Configuration Template
# 复制此文件为 .env 并填入你的实际配置
# Copy this file to .env and fill in your actual configuration

# GeoServer 连接配置 / GeoServer Connection
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=chensi
GEOSERVER_PASS=your-password-here

# GeoServer 内网地址 (如果不同) / Internal GeoServer Address (if different)
# GEOSERVER_INTERNAL_URL=http://10.253.22.15:8080/geoserver

# 数据目录配置 / Data Directory Configuration
# IBTRACS_DATA_DIR=D:/web-flood-insurance-model/Data/IBTracks
# MACAU_DATA_DIR=D:/web-flood-insurance-model/Data/Typhoon_FloodResult_Macau/WGS84

# 部署说明 / Deployment Instructions:
# 1. 复制此文件: copy .env.example .env  (Windows) 或 cp .env.example .env (Linux/Mac)
# 2. 编辑 .env 文件，填入你的 GeoServer 账号密码
# 3. 确保 .env 不会被提交到 Git (已在 .gitignore 中配置)
# 4. 运行脚本时会自动读取 .env 中的配置
