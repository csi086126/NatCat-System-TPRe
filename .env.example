# GeoServer Configuration Template
# 复制此文件为 .env 并填入你的实际配置
# Copy this file to .env and fill in your actual configuration

# GeoServer 连接配置 / GeoServer Connection
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=chensi
GEOSERVER_PASS=your-password-here

# Server-side WMS endpoint used by Risk Map hazard queries. This can point to
# an internal GeoServer URL that is not exposed to the browser.
HAZARD_GEOSERVER_WMS_URL=http://localhost:8080/geoserver/wms
FLOOD_INUNDATION_THRESHOLD_METERS=0.15
FLOOD_SAMPLING_RADIUS_METERS=20

# Macau provisional 22-layer Risk Map GeoServer publication convention
NEXT_PUBLIC_MACAU_DESIGN_GEOSERVER_WORKSPACE=natcat_platform
NEXT_PUBLIC_MACAU_DESIGN_LAYER_PREFIX=MO_Flood_Design_

# GeoServer 内网地址 (如果不同) / Internal GeoServer Address (if different)
# GEOSERVER_INTERNAL_URL=http://10.253.22.15:8080/geoserver

# Risk Map 查询历史 FastAPI 服务地址 (Portfolio Management API, 8000 端口)
# 未配置时默认 http://localhost:8000
QUERY_HISTORY_SERVICE_URL=http://localhost:8000

# FastAPI CORS 允许的 origin。多个用逗号分隔;设为 * 放行所有 origin(仅开发用)。
# 生产必须显式列出域名,如:ALLOWED_ORIGINS=https://natcat.example.com,https://admin.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3004

# 前端展示用的服务地址(文档页、按钮跳转等)
NEXT_PUBLIC_PORTFOLIO_API_URL=http://localhost:8000
NEXT_PUBLIC_GEOSERVER_URL=http://localhost:8080
NEXT_PUBLIC_OASIS_UI_URL=http://localhost:8088
NEXT_PUBLIC_OASISLMF_API_URL=http://localhost:8000

# === Local debug: bypass auth ===
# 设为 true 时,前端 AuthContext 走 mock,跳过 FastAPI /api/auth/* 调用,
# 打开网站直接以 admin@natcat.local 进入主页(后端不受影响)。
# 仅用于本地调试;部署到任何共享环境必须保持 false 或不设置。
NEXT_PUBLIC_AUTH_BYPASS=false

# GeoServer 安装/数据根目录(影响 fix-hk-historical-* 与 republish-hk-historical-layers 脚本)
# Windows 默认 C:\ProgramData\GeoServer;Linux/容器下指向挂载的 /opt/geoserver/data
GEOSERVER_HOME=C:/ProgramData/GeoServer

# 数据目录配置 / Data Directory Configuration
# 绝对路径因操作系统而异。下面列出本项目各脚本会读取的目录变量名,部署时请按目标机器实际位置覆盖。
TPHK_DATA_DIR=D:/Nat Cat Platform/Data/Insurance_data_Taiping/TPHK
TPMO_DATA_DIR=D:/Nat Cat Platform/Data/Insurance_data_Taiping/TPMO
IBTRACS_DATA_DIR=D:/web-flood-insurance-model/Data/IBTracks
INSURANCE_DATA_DIR=D:/web-flood-insurance-model/Data/Insurance_data
SHAPEFILE_DIR=D:/Nat Cat Platform/Data/Shapefile
GADM_DATA_DIR=D:/web-flood-insurance-model/Data/Shapefile
HK_FLOOD_DATA_DIR=D:/Nat Cat Platform/FloodData/HK_FloodData
PUBLIC_DATA_DIR=D:/Nat Cat Platform/UI_system/public/data
# MACAU_DATA_DIR=D:/web-flood-insurance-model/Data/Typhoon_FloodResult_Macau/WGS84

# 部署说明 / Deployment Instructions:
# 1. 复制此文件: copy .env.example .env  (Windows) 或 cp .env.example .env (Linux/Mac)
# 2. 编辑 .env 文件，填入你的 GeoServer 账号密码
# 3. 确保 .env 不会被提交到 Git (已在 .gitignore 中配置)
# 4. 运行脚本时会自动读取 .env 中的配置

# === 后端 (scripts/portfolio_management) 数据库凭证 ===
# 本地 PostgreSQL 凭据。FastAPI api/database.py 读取这些。
DB_HOST=localhost
DB_PORT=5432
DB_NAME=natcat_portfolio
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# === 第三方 API Key(geocoding 子模块需要) ===
# Google Maps Geocoding API key(在 https://console.cloud.google.com 申请)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# 高德地图 Web 服务 API key(在 https://lbs.amap.com 申请)
AMAP_API_KEY=your_amap_api_key_here

# === 阿里云 OSS(PDF 报告存储) ===
# 从阿里云 RAM 控制台创建,权限:开发用 AliyunOSSFullAccess,生产用最小权限子账号
# OSS 未配置时,前端下载按钮会自动降级到 jsPDF fallback(无存档)
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_BUCKET_NAME=natcat-reports
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_SIGNED_URL_TTL_HOURS=24

# === FastAPI 后端配置 ===
# 启动端口(同时被 scripts/portfolio_management/run-api.bat 读取)
FASTAPI_PORT=8765
# 用于生成 /set-password 等邮件链接的前端 base URL
FRONTEND_URL=http://localhost:3004
# JWT 签名密钥 — 用 `python -c "import secrets;print(secrets.token_urlsafe(64))"` 生成
JWT_SECRET=your-jwt-secret-change-in-production-use-secrets-token-urlsafe
JWT_TTL_HOURS=24
# bcrypt 加密 rounds(10 = 默认;生产可提到 12)
BCRYPT_ROUNDS=10

# === 邮件 (SMTP) ===
# 邮件用于注册验证、密码重置。开发期可设 SMTP_MOCK=true 用控制台日志代替真发
SMTP_MOCK=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_USE_SSL=false
SENDER_EMAIL=noreply@natcat.local
SENDER_NAME=NatCat Platform
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=2

# === 应用环境标识 ===
# development / staging / production
NATCAT_ENV=development
