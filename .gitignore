# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Large/generated geocoding intermediates (keep locally, do not upload)
/public/data/tphk-geocoding-*.json
/public/data/tphk-geocoded-portfolio*.json
/public/data/tphk-oed-*.json
/public/data/tphk-portfolio-oed-*.json
/public/data/by-year/tphk-portfolio-*.json
/public/data/macau/tpmo-*.json
/public/data/**/*portfolio*.json
/public/data/**/*portfolio*.geojson
/public/data/test-oed-with-originals.json
/scripts/portfolio_management/output/

# PDF 报告后端 — 思源黑体二进制(~33MB 总量),首次部署从 GitHub 下载
/scripts/portfolio_management/pdf_service/fonts/*.otf

# Business-data correction artifacts (may contain client locations)
/correction-report.json
/geocoding-*-corrections*.json
/geocoding-corrections-*.json
/geocoding-cluster-corrections-log.json

# Downloaded GIS source layers (reproducible and too large for GitHub)
/scripts/downloaded_layers/
/scripts/generated/macau-flood-hazard/

# Local PostgreSQL backups (contain business data and may be large)
/backups/

# Local runtime artifacts and temporary analysis output
/nul
/public/data/nul
*.log
/temp_*.json
/*-output.txt
/test-output.txt

# Python virtual environments
geo_env/
venv/
env/
ENV/
*.pyc
__pycache__/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Next.js dev artifacts (Turbopack) — rebuilds on next dev, never commit
/.next-dev/

# Local raster scratch (regenerated by data-processing scripts)
/.masked_tiffs/

# Refactor-backup pattern — never commit files like *_before_restore.tsx
/*_before_restore.tsx

# Image scratch / comparison outputs (regenerated by ad-hoc scripts)
/tile_top.png
/compare*.png
/district_wgs84_rgb.jpg
/check_env_out.txt

# Test/debug PNG / JPG snapshots (regenerated by probe scripts)
/esri_3x3_*.png
/legend_*.png
/mo_*.png
/mo_*.jpg
/mo_predio_rgb.jpg
/overlay_*.png
/test_*.png
/test_*.jpg
/test_pipe_*.png
/test_predio_*.png
/taiping_boundary.png
/tile_bottom.png
/tile_center.png
/tile_left.png
/tile_right.png
/scripts/migration_out/
/scripts/MO_DEM_TIF_clipped_*.tif
/scripts/cdrom_c_wgs84_data/
/scripts/generated/
nul-*
